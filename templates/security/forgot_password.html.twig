{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
<div class="form-container glass">
    {{ form_start(form) }}
        <h1 class="h3 mb-3 font-weight-normal" style="text-align:center;color:var(--primary-color);">Mot de passe oublié</h1>

        <p style="color:#6b7280;font-size:0.9rem;margin-bottom:1.5rem;">
            Saisissez l'adresse email de votre compte. Nous vous enverrons un lien pour choisir un nouveau mot de passe.
            Ce lien est valable une heure.
        </p>

        {{ form_row(form.email) }}

        <button class="btn btn-lg btn-primary" type="submit" style="width:100%;margin-top:1rem;">
            Envoyer le lien
        </button>

        <p style="text-align:center;margin-top:1rem;">
            <a href="{{ path('app_login') }}" style="color: var(--primary-color);">Retour à la connexion</a>
        </p>
    {{ form_end(form) }}
</div>
{% endblock %}
