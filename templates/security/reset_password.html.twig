{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block body %}
<div class="form-container glass">
    {{ form_start(form) }}
        <h1 class="h3 mb-3 font-weight-normal" style="text-align:center;color:var(--primary-color);">Nouveau mot de passe</h1>

        <p style="color:#4b5563;font-size:0.9rem;margin-bottom:1.5rem;">
            Choisissez un nouveau mot de passe pour votre compte.
        </p>

        {{ form_row(form.plainPassword.first) }}
        {{ form_row(form.plainPassword.second) }}

        <button class="btn btn-lg btn-primary" type="submit" style="width:100%;margin-top:1rem;">
            Enregistrer le nouveau mot de passe
        </button>
    {{ form_end(form) }}
</div>
{% endblock %}
