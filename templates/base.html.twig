<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Vite & Gourmand — Traiteur{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🥗</text></svg>">
        
        {# Google Fonts #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
        
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="page-{{ app.request.attributes.get('_route') }}">
        <nav class="navbar glass">
            <a href="{{ path('app_home') }}" class="navbar-brand">Vite & Gourmand</a>
            <div class="nav-links">
                <a href="{{ path('app_home') }}" class="nav-link">Accueil</a>
                <a href="{{ path('app_menu') }}" class="nav-link">La Carte</a>
                <a href="{{ path('app_contact') }}" class="nav-link">Contact</a>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin_dashboard') }}" class="nav-link"><i class="fa-solid fa-chart-column"></i> Tableau de bord</a>
                    <a href="{{ path('admin_employee_index') }}" class="nav-link"><i class="fa-solid fa-users-gear"></i> Employés</a>
                {% endif %}
                {% if is_granted('ROLE_EMPLOYEE') %}
                    <a href="{{ path('admin_menu_index') }}" class="nav-link"><i class="fa-solid fa-gear"></i> Administration</a>
                {% endif %}
                {% if app.user %}
                    <a href="{{ path('user_profile') }}" class="nav-link"><i class="fa-solid fa-user"></i> Mon compte</a>
                    <a href="{{ path('user_orders') }}" class="nav-link"><i class="fa-solid fa-box"></i> Commandes</a>
                    <a href="{{ path('app_logout') }}" class="nav-link btn btn-secondary">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="nav-link">Connexion</a>
                    <a href="{{ path('app_register') }}" class="nav-link btn btn-primary">S'inscrire</a>
                {% endif %}
            </div>
        </nav>

        {# Messages flash affiches sur toutes les pages : confirmations,
           avertissements et erreurs remontes par les controleurs. #}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                {% set palette = {
                    'success': {'bg': 'rgba(16,185,129,0.12)', 'border': '#10B981', 'text': '#065F46', 'icon': 'fa-circle-check'},
                    'error':   {'bg': 'rgba(239,68,68,0.12)',  'border': '#EF4444', 'text': '#991B1B', 'icon': 'fa-circle-exclamation'},
                    'danger':  {'bg': 'rgba(239,68,68,0.12)',  'border': '#EF4444', 'text': '#991B1B', 'icon': 'fa-circle-exclamation'},
                    'warning': {'bg': 'rgba(245,158,11,0.12)', 'border': '#F59E0B', 'text': '#92400E', 'icon': 'fa-triangle-exclamation'},
                    'info':    {'bg': 'rgba(59,130,246,0.12)', 'border': '#3B82F6', 'text': '#1E40AF', 'icon': 'fa-circle-info'}
                } %}
                {% set style = palette[type]|default(palette.info) %}
                <div role="alert" style="max-width:1200px;margin:1.5rem auto 0;padding:1rem 1.25rem;border-radius:0.75rem;background:{{ style.bg }};border-left:4px solid {{ style.border }};color:{{ style.text }};font-weight:500;">
                    <i class="fa-solid {{ style.icon }}"></i> {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
        
        <footer style="background-color: var(--dark-bg); color: var(--white); padding: 3rem 2rem 1.5rem;">
            <div style="max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2rem; margin-bottom: 2rem;">
                <div>
                    <h3 style="color: var(--primary-color); font-family: var(--font-heading); margin-bottom: 1rem;">Vite & Gourmand</h3>
                    <p style="color: #9CA3AF; font-size: 0.9rem; line-height: 1.6;">Traiteur événementiel haut de gamme pour tous vos événements professionnels et personnels.</p>
                </div>
                <div>
                    <h4 style="margin-bottom: 1rem; font-size: 1rem;">Horaires d'ouverture</h4>
                    <ul style="list-style: none; padding: 0; color: #9CA3AF; font-size: 0.9rem; line-height: 2;">
                        {% for horaire in horaires %}
                            <li>
                                {{ horaire.jour|capitalize }} :
                                {% if horaire.ferme %}
                                    <strong style="color: #EF4444;">Fermé</strong>
                                {% else %}
                                    <strong style="color: white;">{{ horaire.heureOuverture }} – {{ horaire.heureFermeture }}</strong>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
                <div>
                    <h4 style="margin-bottom: 1rem; font-size: 1rem;">Contact</h4>
                    <ul style="list-style: none; padding: 0; color: #9CA3AF; font-size: 0.9rem; line-height: 2;">
                        <li><i class="fa-solid fa-location-dot"></i> 12 Rue de la Gastronomie, 75001 Paris</li>
                        <li><i class="fa-solid fa-phone"></i> 01 23 45 67 89</li>
                        <li><i class="fa-solid fa-envelope"></i> contact@vite-gourmand.fr</li>
                    </ul>
                </div>
                <div>
                    <h4 style="margin-bottom: 1rem; font-size: 1rem;">Liens utiles</h4>
                    <ul style="list-style: none; padding: 0; font-size: 0.9rem; line-height: 2;">
                        <li><a href="{{ path('app_menu') }}" style="color: #9CA3AF; transition: color 0.2s;" onmouseover="this.style.color='#10B981'" onmouseout="this.style.color='#9CA3AF'">La Carte</a></li>
                        <li><a href="{{ path('app_contact') }}" style="color: #9CA3AF; transition: color 0.2s;" onmouseover="this.style.color='#10B981'" onmouseout="this.style.color='#9CA3AF'">Nous Contacter</a></li>
                        {% if not app.user %}
                        <li><a href="{{ path('app_register') }}" style="color: #9CA3AF; transition: color 0.2s;" onmouseover="this.style.color='#10B981'" onmouseout="this.style.color='#9CA3AF'">Créer un compte</a></li>
                        {% endif %}
                        <li><a href="{{ path('app_mentions_legales') }}" style="color: #9CA3AF; transition: color 0.2s;" onmouseover="this.style.color='#10B981'" onmouseout="this.style.color='#9CA3AF'">Mentions légales</a></li>
                        <li><a href="{{ path('app_cgv') }}" style="color: #9CA3AF; transition: color 0.2s;" onmouseover="this.style.color='#10B981'" onmouseout="this.style.color='#9CA3AF'">CGV</a></li>
                    </ul>
                </div>
            </div>
            <div style="border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1.5rem; text-align: center; color: #6B7280; font-size: 0.85rem;">
                &copy; {{ "now"|date("Y") }} Vite & Gourmand. Tous droits réservés.
            </div>
        </footer>
    </body>
</html>
