{% extends 'base.html.twig' %}

{% block title %}{{ menu.name }} - Vite & Gourmand{% endblock %}

{% block body %}
<div style="min-height: 100vh; background: linear-gradient(135deg, #e0f2fe 0%, #dcfce7 100%);">
    <div style="max-width: 900px; margin: 0 auto; padding: 2rem;">

        <a href="{{ path('app_menu') }}" style="color: var(--primary-color); display: inline-flex; align-items: center; gap: 0.5rem; margin-bottom: 2rem; font-weight: 600;">
            ← Retour au menu
        </a>

        <div class="glass" style="padding: 2.5rem; border-radius: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
                <div>
                    <h1 style="font-size: 2.5rem; color: var(--dark-bg); margin-bottom: 0.5rem;">{{ menu.name }}</h1>
                    {% if menu.description %}
                        <p style="color: #4b5563; font-size: 1.1rem; max-width: 600px;">{{ menu.description }}</p>
                    {% endif %}
                </div>
                <div style="text-align: right;">
                    <div style="font-size: 2rem; font-weight: bold; color: var(--secondary-color);">{{ menu.minGroupPrice|number_format(2, ',', ' ') }} €</div>
                    <div style="color: #4B5563; font-size: 0.9rem;">pour {{ menu.minPeople ?? 1 }} personnes minimum</div>
                    <div style="color: #4B5563; font-size: 0.9rem;">soit {{ menu.price|number_format(2, ',', ' ') }} € par personne</div>
                </div>
            </div>

            {# Galerie de photos du menu.
               Accessibilite (RGAA) : chaque photo a un texte alternatif, les
               miniatures sont de vrais boutons (utilisables au clavier avec Tab
               puis Entree ou Espace) et aria-pressed indique la photo affichee. #}
            {% set galleryImages = [] %}
            {% for image in menu.images %}
                {% set galleryImages = galleryImages|merge([{src: asset(image.path), alt: image.alt ?: 'Photo du menu ' ~ menu.name}]) %}
            {% endfor %}
            {% if galleryImages is empty and menu.imageName %}
                {% set galleryImages = [{src: asset('images/menus/' ~ menu.imageName), alt: 'Photo du menu ' ~ menu.name}] %}
            {% endif %}

            {% if galleryImages is not empty %}
                <section aria-label="Galerie de photos du menu {{ menu.name }}" style="margin-top: 2rem;">
                    <figure style="margin: 0;">
                        <img id="gallery-main" src="{{ galleryImages[0].src }}" alt="{{ galleryImages[0].alt }}"
                             style="width: 100%; height: 380px; object-fit: cover; border-radius: 1rem; display: block;">
                        <figcaption id="gallery-caption" aria-live="polite" style="margin-top: 0.5rem; color: #4B5563; font-size: 0.9rem;">
                            Photo 1 sur {{ galleryImages|length }}
                        </figcaption>
                    </figure>

                    {% if galleryImages|length > 1 %}
                        <ul style="list-style: none; padding: 0; margin: 0.75rem 0 0; display: flex; gap: 0.6rem; flex-wrap: wrap;">
                            {% for img in galleryImages %}
                                <li>
                                    <button type="button" class="gallery-thumb"
                                            data-src="{{ img.src }}" data-alt="{{ img.alt }}" data-index="{{ loop.index }}"
                                            aria-pressed="{{ loop.first ? 'true' : 'false' }}"
                                            aria-label="Afficher la photo {{ loop.index }} sur {{ galleryImages|length }}"
                                            style="padding: 0; border: 3px solid {{ loop.first ? 'var(--primary-color)' : 'transparent' }}; border-radius: 0.6rem; background: none; cursor: pointer; line-height: 0;">
                                        <img src="{{ img.src }}" alt="" style="width: 90px; height: 64px; object-fit: cover; border-radius: 0.4rem;">
                                    </button>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </section>
            {% endif %}

            {# Thematiques et regimes du menu : l'enonce demande que toutes les
               informations du menu enregistrees en base soient visibles ici. #}
            {% if menu.themes is not empty or menu.diets is not empty %}
                <dl style="display: flex; flex-wrap: wrap; gap: 1.5rem; margin: 2rem 0 0;">
                    {% if menu.themes is not empty %}
                        <div>
                            <dt style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: #4B5563; font-weight: 600; margin-bottom: 0.4rem;">Thème</dt>
                            <dd style="margin: 0; display: flex; gap: 0.4rem; flex-wrap: wrap;">
                                {% for theme in menu.themes %}
                                    <span style="background: rgba(99,102,241,0.12); color: #3730A3; padding: 0.3rem 0.8rem; border-radius: 999px; font-size: 0.9rem; font-weight: 600;">{{ theme.name }}</span>
                                {% endfor %}
                            </dd>
                        </div>
                    {% endif %}
                    {% if menu.diets is not empty %}
                        <div>
                            <dt style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: #4B5563; font-weight: 600; margin-bottom: 0.4rem;">Régime alimentaire</dt>
                            <dd style="margin: 0; display: flex; gap: 0.4rem; flex-wrap: wrap;">
                                {% for diet in menu.diets %}
                                    <span style="background: rgba(16,185,129,0.15); color: #065F46; padding: 0.3rem 0.8rem; border-radius: 999px; font-size: 0.9rem; font-weight: 600;">{{ diet.name }}</span>
                                {% endfor %}
                            </dd>
                        </div>
                    {% endif %}
                </dl>
            {% endif %}

            <div style="display: flex; gap: 2rem; margin: 2rem 0; flex-wrap: wrap;">
                {% if menu.minPeople %}
                <div style="background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); border-radius: 0.75rem; padding: 1rem 1.5rem; text-align: center;">
                    <div style="font-size: 1.5rem; font-weight: bold; color: var(--primary-color);">{{ menu.minPeople }}</div>
                    <div style="font-size: 0.85rem; color: #4b5563;">personnes minimum</div>
                </div>
                {% endif %}
                {% if menu.stock is not null %}
                <div style="background: {% if menu.stock > 5 %}rgba(16,185,129,0.1){% elseif menu.stock > 0 %}rgba(249,115,22,0.1){% else %}rgba(239,68,68,0.1){% endif %}; border: 1px solid {% if menu.stock > 5 %}rgba(16,185,129,0.3){% elseif menu.stock > 0 %}rgba(249,115,22,0.3){% else %}rgba(239,68,68,0.3){% endif %}; border-radius: 0.75rem; padding: 1rem 1.5rem; text-align: center;">
                    <div style="font-size: 1.5rem; font-weight: bold; color: {% if menu.stock > 5 %}var(--primary-color){% elseif menu.stock > 0 %}var(--secondary-color){% else %}#EF4444{% endif %};">
                        {% if menu.stock > 0 %}{{ menu.stock }}{% else %}Épuisé{% endif %}
                    </div>
                    <div style="font-size: 0.85rem; color: #4b5563;">{% if menu.stock > 0 %}disponibles{% endif %}</div>
                </div>
                {% endif %}
            </div>

            <hr style="border: none; border-top: 1px solid rgba(0,0,0,0.1); margin: 2rem 0;">

            <h2 style="font-size: 1.5rem; margin-bottom: 1.5rem;">Composition du menu</h2>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">
                {% for product in menu.products %}
                <div style="background: rgba(255,255,255,0.6); border: 1px solid rgba(255,255,255,0.5); border-radius: 1rem; padding: 1.25rem;">
                    <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--primary-color); font-weight: 600; margin-bottom: 0.25rem;">
                        {{ product.category|capitalize }}
                    </div>
                    <div style="font-weight: 700; font-size: 1.1rem; margin-bottom: 0.5rem;">{{ product.name }}</div>
                    {% if product.description %}
                        <div style="color: #4b5563; font-size: 0.9rem;">{{ product.description }}</div>
                    {% endif %}
                    {% if product.diets|length > 0 %}
                    <div style="margin-top: 0.75rem; display: flex; gap: 0.25rem; flex-wrap: wrap;">
                        {% for diet in product.diets %}
                            <span style="background: rgba(16,185,129,0.15); color: var(--primary-color); font-size: 0.7rem; padding: 0.15rem 0.5rem; border-radius: 999px; font-weight: 600;"><i class="fa-solid fa-leaf" aria-hidden="true"></i> {{ diet.name }}</span>
                        {% endfor %}
                    </div>
                    {% endif %}
                    {% if product.allergens|length > 0 %}
                    <div style="margin-top: 0.5rem; display: flex; gap: 0.25rem; flex-wrap: wrap;">
                        {% for allergen in product.allergens %}
                            <span style="background: rgba(249,115,22,0.15); color: var(--secondary-color); font-size: 0.7rem; padding: 0.15rem 0.5rem; border-radius: 999px; font-weight: 600;"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {{ allergen.name }}</span>
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>

            {# Conditions du menu, mises bien en evidence juste avant le bouton de
               commande : le client ne peut pas dire qu'il n'a pas vu l'information. #}
            {% if menu.conditions %}
                <div role="note" style="margin-top:2.5rem;background:rgba(245,158,11,0.10);border:2px solid #F59E0B;border-radius:1rem;padding:1.5rem;">
                    <h3 style="margin:0 0 0.75rem;color:#92400E;font-size:1.1rem;display:flex;align-items:center;gap:0.6rem;">
                        <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> Conditions de ce menu
                    </h3>
                    <p style="margin:0;color:#78350F;line-height:1.7;white-space:pre-line;">{{ menu.conditions }}</p>
                    <p style="margin:1rem 0 0;color:#92400E;font-size:0.85rem;font-weight:600;">
                        En commandant ce menu, vous acceptez ces conditions ainsi que nos
                        <a href="{{ path('app_cgv') }}" style="color:#92400E;">conditions générales de vente</a>.
                    </p>
                </div>
            {% endif %}

            <style>
                .order-actions { margin-top: 3rem; text-align: center; }
                .order-actions__buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
                .order-actions__buttons .btn { box-sizing: border-box; max-width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 1rem 2rem; font-size: 1.05rem; text-align: center; line-height: 1.3; }
                .order-actions__buttons .btn-outline { background: #fff; border: 2px solid var(--primary-color); color: var(--primary-color); }
                @media (max-width: 600px) {
                    .order-actions__buttons { flex-direction: column; }
                    .order-actions__buttons .btn { width: 100%; padding: 0.9rem 1rem; }
                }
            </style>
            <div class="order-actions">
                {% if menu.stock is not null and menu.stock <= 0 %}
                    <div class="order-actions__buttons">
                        <button class="btn" style="background: #9CA3AF; color: white; cursor: not-allowed;" disabled>
                            Menu épuisé
                        </button>
                    </div>
                {% elseif app.user %}
                    <div class="order-actions__buttons">
                        <a href="{{ path('order_create', {'menuId': menu.id}) }}" class="btn btn-primary">
                            <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i> Commander ce menu
                        </a>
                    </div>
                {% else %}
                    <p style="margin-bottom:1rem;color:#4b5563;">Vous devez être connecté pour commander.</p>
                    <div class="order-actions__buttons">
                        <a href="{{ path('app_login') }}" class="btn btn-primary">
                            Connectez-vous pour commander
                        </a>
                        <a href="{{ path('app_register') }}" class="btn btn-outline">
                            Créer un compte
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% if menu.images|length > 1 %}
<script>
// Miniature cliquee (ou activee au clavier) -> la photo s'affiche en grand.
(function () {
    const main = document.getElementById('gallery-main');
    const caption = document.getElementById('gallery-caption');
    const thumbs = document.querySelectorAll('.gallery-thumb');
    if (!main || thumbs.length === 0) { return; }

    thumbs.forEach(function (thumb) {
        thumb.addEventListener('click', function () {
            main.src = thumb.dataset.src;
            main.alt = thumb.dataset.alt;
            caption.textContent = 'Photo ' + thumb.dataset.index + ' sur ' + thumbs.length;
            thumbs.forEach(function (t) {
                const active = t === thumb;
                t.setAttribute('aria-pressed', active ? 'true' : 'false');
                t.style.borderColor = active ? 'var(--primary-color)' : 'transparent';
            });
        });
    });
})();
</script>
{% endif %}
{% endblock %}
