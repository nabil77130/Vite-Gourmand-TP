{% extends 'base.html.twig' %}

{% block title %}Contact - Vite & Gourmand{% endblock %}

{% block body %}
<div style="min-height: 100vh; background: linear-gradient(135deg, #e0f2fe 0%, #dcfce7 100%);">
    <div style="max-width: 700px; margin: 0 auto; padding: 2rem;">

        <div class="glass" style="padding: 2.5rem; border-radius: 1.5rem;">
            <h1 style="text-align: center; color: var(--primary-color); margin-bottom: 0.5rem;">Contactez-nous</h1>
            <p style="text-align: center; color: #4b5563; margin-bottom: 2rem;">Une question ? Un événement à organiser ? Nous sommes là pour vous aider.</p>

            {# Les messages de confirmation et d'erreur sont affiches par base.html.twig #}

            <style>
                .contact-names { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
                @media (max-width: 600px) { .contact-names { grid-template-columns: 1fr; } }
            </style>
            <form method="post" action="{{ path('app_contact') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('contact') }}">
                <div class="contact-names">
                    <div class="form-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 0.4rem;" for="champ-firstName">Prénom *</label>
                        <input id="champ-firstName" type="text" name="firstName" class="form-control" placeholder="Votre prénom" required>
                    </div>
                    <div class="form-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 0.4rem;" for="champ-lastName">Nom *</label>
                        <input id="champ-lastName" type="text" name="lastName" class="form-control" placeholder="Votre nom" required>
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: 600; margin-bottom: 0.4rem;" for="champ-email">Email *</label>
                    <input id="champ-email" type="email" name="email" class="form-control" placeholder="votre@email.com" required>
                </div>

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: 600; margin-bottom: 0.4rem;" for="champ-phone">Téléphone</label>
                    <input id="champ-phone" type="tel" name="phone" class="form-control" placeholder="06 00 00 00 00">
                </div>

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: 600; margin-bottom: 0.4rem;" for="champ-subject">Sujet *</label>
                    <select id="champ-subject" name="subject" class="form-control" required>
                        <option value="">-- Choisissez un sujet --</option>
                        <option value="devis">Demande de devis</option>
                        <option value="reservation">Réservation</option>
                        <option value="information">Demande d'information</option>
                        <option value="reclamation">Réclamation</option>
                        <option value="autre">Autre</option>
                    </select>
                </div>

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: 600; margin-bottom: 0.4rem;" for="champ-eventDate">Date de l'événement</label>
                    <input id="champ-eventDate" type="date" name="eventDate" class="form-control">
                </div>

                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label style="display: block; font-weight: 600; margin-bottom: 0.4rem;" for="champ-message">Message *</label>
                    <textarea id="champ-message" name="message" class="form-control" rows="5" placeholder="Décrivez votre projet ou votre demande..." required style="resize: vertical;"></textarea>
                </div>

                <button type="submit" class="btn btn-primary" style="width: 100%; font-size: 1.1rem;">
                    Envoyer le message
                </button>
            </form>

            <div style="margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid rgba(0,0,0,0.1); display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.5rem; text-align: center;">
                <div>
                    <div style="font-size: 1.5rem; margin-bottom: 0.5rem;"><i class="fa-solid fa-location-dot" aria-hidden="true"></i></div>
                    <div style="font-weight: 600; margin-bottom: 0.25rem;">Adresse</div>
                    <div style="color: #4b5563; font-size: 0.9rem;">12 Rue de la Gastronomie<br>33000 Bordeaux</div>
                </div>
                <div>
                    <div style="font-size: 1.5rem; margin-bottom: 0.5rem;"><i class="fa-solid fa-phone" aria-hidden="true"></i></div>
                    <div style="font-weight: 600; margin-bottom: 0.25rem;">Téléphone</div>
                    <div style="color: #4b5563; font-size: 0.9rem;">05 56 00 00 00</div>
                </div>
                <div>
                    <div style="font-size: 1.5rem; margin-bottom: 0.5rem;"><i class="fa-solid fa-envelope" aria-hidden="true"></i></div>
                    <div style="font-weight: 600; margin-bottom: 0.25rem;">Email</div>
                    <div style="color: #4b5563; font-size: 0.9rem;">contact@vite-gourmand.fr</div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
