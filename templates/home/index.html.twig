{% extends 'base.html.twig' %}

{% block title %}Vite & Gourmand — Traiteur à Bordeaux{% endblock %}

{% block body %}
    {# Hero Section #}
    <section class="hero">
        <div class="hero-content glass">
            <h1>Un traiteur d'exception pour vos événements</h1>
            <p>Des menus raffinés préparés avec des produits frais et locaux. Faites de chaque événement un moment inoubliable.</p>
            <a href="{{ path('app_menu') }}" class="btn btn-secondary">Découvrir nos menus</a>
        </div>
    </section>

    {# Presentation de l'entreprise et du professionnalisme de l'equipe,
       demandes par l'enonce pour la page d'accueil. #}
    <section aria-labelledby="qui-sommes-nous" style="max-width:1200px;margin:4rem auto;padding:0 2rem;">
        <div class="glass" style="padding:2.5rem;border-radius:1.5rem;">
            <h2 id="qui-sommes-nous" style="font-size:1.8rem;margin:0 0 1rem;">Qui sommes-nous ?</h2>
            <p style="font-size:1.05rem;line-height:1.8;color:#374151;max-width:850px;margin:0 0 1rem;">
                Depuis <strong>25 ans</strong>, <strong>Julie et José</strong> régalent les Bordelais. Repas de Noël, déjeuner de Pâques,
                anniversaire, mariage ou séminaire : Vite &amp; Gourmand prépare des menus adaptés à chaque événement,
                de quelques convives à plusieurs dizaines de personnes.
            </p>
            <p style="font-size:1.05rem;line-height:1.8;color:#374151;max-width:850px;margin:0 0 2rem;">
                Notre carte évolue au fil des saisons et de vos envies. Chaque menu est cuisiné dans notre atelier de Bordeaux,
                puis livré et mis en place par notre équipe.
            </p>
            <h3 style="font-size:1.2rem;margin:0 0 1rem;">Une équipe de professionnels à votre service</h3>
            <ul style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.25rem;">
                <li style="background:rgba(255,255,255,0.7);border-radius:1rem;padding:1.25rem;">
                    <strong style="display:block;color:#065F46;margin-bottom:0.35rem;"><i class="fa-solid fa-award" aria-hidden="true"></i> 25 ans de savoir-faire</strong>
                    <span style="color:#374151;">Une cuisine maison, préparée par une équipe formée à la restauration événementielle.</span>
                </li>
                <li style="background:rgba(255,255,255,0.7);border-radius:1rem;padding:1.25rem;">
                    <strong style="display:block;color:#065F46;margin-bottom:0.35rem;"><i class="fa-solid fa-clock" aria-hidden="true"></i> Des délais tenus</strong>
                    <span style="color:#374151;">Chaque commande est suivie étape par étape, de la préparation jusqu'à la livraison.</span>
                </li>
                <li style="background:rgba(255,255,255,0.7);border-radius:1rem;padding:1.25rem;">
                    <strong style="display:block;color:#065F46;margin-bottom:0.35rem;"><i class="fa-solid fa-utensils" aria-hidden="true"></i> Un service clé en main</strong>
                    <span style="color:#374151;">Livraison, matériel de service prêté et conseils pour réussir votre réception.</span>
                </li>
            </ul>
        </div>
    </section>

    {# Menus en vedette #}
    <section class="products-grid" style="max-width:1200px;margin:4rem auto;padding:0 2rem;">
        <h2 style="grid-column:1/-1;font-size:1.8rem;font-weight:700;margin-bottom:1.5rem;"><i class="fa-solid fa-utensils" aria-hidden="true"></i> Nos menus du moment</h2>
        {% for menu in featuredProducts %}
            <div class="product-card glass" style="border:2px solid var(--primary-color);">
                {% set mainDish = menu.products|filter(p => p.category == 'main')|first %}
                {# Priority: Menu Image > Main Dish Image > First Product Image > Placeholder #}
                {% set displayImage = menu.imageName ? 'menus/' ~ menu.imageName : (mainDish ? 'products/' ~ mainDish.imageName : (menu.products|length > 0 ? 'products/' ~ menu.products[0].imageName : null)) %}
                
                {% if displayImage %}
                    <img src="{{ asset('images/' ~ displayImage) }}" class="product-image" alt="{{ menu.name }}">
                {% else %}
                    <img src="https://placehold.co/600x400/15803D/FFFFFF?text={{ menu.name|url_encode }}" class="product-image" alt="{{ menu.name }}">
                {% endif %}
                <div class="product-details">
                    <h3>{{ menu.name }}</h3>
                    <p>{{ menu.description }}</p>
                    <ul style="list-style:none;padding:0;margin:0.75rem 0;">
                        {% for product in menu.products|slice(0,3) %}
                            <li style="color:#4b5563;font-size:0.9rem;padding:0.15rem 0;">• {{ product.name }}</li>
                        {% endfor %}
                        {% if menu.products|length > 3 %}<li style="color:#4b5563;font-size:0.85rem;">+ {{ menu.products|length - 3 }} autres plats…</li>{% endif %}
                    </ul>
                    {% if menu.minPeople %}
                        <span style="background:rgba(16,185,129,0.15);color:var(--primary-color);font-size:0.8rem;padding:0.2rem 0.6rem;border-radius:999px;font-weight:600;"><i class="fa-solid fa-users" aria-hidden="true"></i> Min. {{ menu.minPeople }} pers.</span>
                    {% endif %}
                    <div class="product-price" style="margin-top:0.75rem;">{{ menu.minGroupPrice|number_format(2, ',', ' ') }} €<span style="font-size:0.8rem;font-weight:400;color:#4b5563;"> pour {{ menu.minPeople ?? 1 }} pers.<br>soit {{ menu.price|number_format(2, ',', ' ') }} € / pers.</span></div>
                    <a href="{{ path('app_menu_show', {'id': menu.id}) }}" class="btn btn-primary" style="width:100%;margin-top:1rem;display:block;text-align:center;">Commander ce menu →</a>
                </div>
            </div>
        {% else %}
            <p style="grid-column:1/-1;color:#4b5563;">Aucun menu disponible pour le moment.</p>
        {% endfor %}
    </section>


    {# Avis Clients #}
    {% if reviews is not empty %}
    <section style="max-width: 1200px; margin: 4rem auto; padding: 2rem;">
        <h2 style="text-align:center;margin-bottom:2rem;"><i class="fa-regular fa-comments" aria-hidden="true"></i> Ce que disent nos clients</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));gap:2rem;">
            {% for review in reviews %}
                <div class="glass" style="padding:1.5rem;border-radius:1rem;">
                    <div style="font-size:1.2rem;margin-bottom:0.5rem;color:#b45309;">
                        <span class="sr-only">Note : {{ review.rating }} sur 5</span>{% for i in 1..5 %}{{ i <= review.rating ? '<i class="fa-solid fa-star" aria-hidden="true"></i>' : '<i class="fa-regular fa-star" aria-hidden="true"></i>' }}{% endfor %}
                    </div>
                    <p style="font-style:italic;color:#4b5563;margin-bottom:1rem;">"{{ review.comment }}"</p>
                    <div style="font-size:0.9rem;color:#4b5563;text-align:right;">
                        — Client Vite & Gourmand
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {# Pourquoi nous choisir #}
    <section class="glass-dark" style="max-width: 1200px; margin: 4rem auto; padding: 4rem; text-align: center;">
        <h2>Pourquoi choisir Vite & Gourmand ?</h2>
        <div style="display: flex; justify-content: space-around; margin-top: 2rem; flex-wrap: wrap; gap: 2rem;">
            <div style="flex: 1; min-width: 250px;">
                <h3><i class="fa-solid fa-carrot" aria-hidden="true"></i> Produits frais</h3>
                <p>Nous nous approvisionnons localement pour garantir la meilleure qualité.</p>
            </div>
            <div style="flex: 1; min-width: 250px;">
                <h3><i class="fa-solid fa-truck-fast" aria-hidden="true"></i> Livraison soignée</h3>
                <p>Vos plats livrés chauds et prêts à servir pour votre événement.</p>
            </div>
            <div style="flex: 1; min-width: 250px;">
                <h3><i class="fa-solid fa-kitchen-set" aria-hidden="true"></i> Chefs expérimentés</h3>
                <p>Préparés par des professionnels de la restauration événementielle.</p>
            </div>
        </div>
    </section>
{% endblock %}

