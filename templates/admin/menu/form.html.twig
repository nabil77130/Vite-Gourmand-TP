{% extends 'base.html.twig' %}
{% block title %}{{ title }}{% endblock %}
{% block body %}
<div style="max-width:800px;margin:2rem auto;padding:0 1rem;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;">
        <h1 style="font-size:1.8rem;font-weight:700;">{{ title }}</h1>
        <a href="{{ path('admin_menu_index') }}" style="color:#4b5563;text-decoration:none;">← Retour aux menus</a>
    </div>

    {% for flash in app.flashes('success') %}
        <div style="background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.4);color:#065F46;border-radius:0.5rem;padding:1rem;margin-bottom:1rem;">✅ {{ flash }}</div>
    {% endfor %}

    <div style="background:white;border-radius:1rem;box-shadow:0 2px 12px rgba(0,0,0,0.08);padding:2rem;">
        {{ form_start(form) }}
        <div style="display:grid;gap:1.25rem;">
            <div>{{ form_label(form.name) }}{{ form_widget(form.name, {attr: {class: 'form-control'}}) }}{{ form_errors(form.name) }}</div>
            <div>{{ form_label(form.description) }}{{ form_widget(form.description, {attr: {class: 'form-control', rows: 4}}) }}{{ form_errors(form.description) }}</div>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;">
                <div>{{ form_label(form.price) }}{{ form_widget(form.price, {attr: {class: 'form-control'}}) }}{{ form_errors(form.price) }}</div>
                <div>{{ form_label(form.minPeople) }}{{ form_widget(form.minPeople, {attr: {class: 'form-control'}}) }}{{ form_errors(form.minPeople) }}</div>
                <div>{{ form_label(form.stock) }}{{ form_widget(form.stock, {attr: {class: 'form-control'}}) }}{{ form_errors(form.stock) }}</div>
            </div>
            <div>
                {{ form_label(form.conditions) }}
                {{ form_widget(form.conditions, {attr: {class: 'form-control'}}) }}
                {{ form_help(form.conditions) }}
                {{ form_errors(form.conditions) }}
            </div>
            <div>
                <label style="font-weight:600;display:block;margin-bottom:0.5rem;">Plats composant ce menu</label>
                <div style="max-height:250px;overflow-y:auto;border:1px solid #e5e7eb;border-radius:0.5rem;padding:1rem;display:grid;grid-template-columns:1fr 1fr;gap:0.5rem;">
                    {{ form_widget(form.products) }}
                </div>
                {{ form_errors(form.products) }}
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                <div>
                    <label style="font-weight:600;display:block;margin-bottom:0.5rem;">Thématiques du menu</label>
                    <div style="border:1px solid #e5e7eb;border-radius:0.5rem;padding:1rem;display:grid;gap:0.4rem;">
                        {{ form_widget(form.themes) }}
                    </div>
                    {{ form_help(form.themes) }}
                </div>
                <div>
                    <label style="font-weight:600;display:block;margin-bottom:0.5rem;">Régimes alimentaires compatibles</label>
                    <div style="border:1px solid #e5e7eb;border-radius:0.5rem;padding:1rem;display:grid;gap:0.4rem;">
                        {{ form_widget(form.diets) }}
                    </div>
                    {{ form_help(form.diets) }}
                </div>
            </div>
            <div>
                {{ form_label(form.newImages) }}
                {{ form_widget(form.newImages, {attr: {class: 'form-control'}}) }}
                {{ form_help(form.newImages) }}
                {{ form_errors(form.newImages) }}
            </div>
        </div>
        <div style="margin-top:1.5rem;display:flex;gap:1rem;">
            <button type="submit" class="btn btn-primary">💾 Enregistrer</button>
            <a href="{{ path('admin_menu_index') }}" style="padding:0.6rem 1.2rem;border-radius:0.5rem;border:1px solid #e5e7eb;text-decoration:none;color:#4b5563;">Annuler</a>
        </div>
        {{ form_end(form) }}
    </div>

    {# Photos deja dans la galerie. Chaque suppression est un petit formulaire
       POST protege par un jeton CSRF, place hors du formulaire principal
       (les formulaires HTML ne peuvent pas etre imbriques). #}
    {% if menu is defined and menu.id %}
        <section aria-labelledby="galerie-titre" style="background:white;border-radius:1rem;box-shadow:0 2px 12px rgba(0,0,0,0.08);padding:2rem;margin-top:1.5rem;">
            <h2 id="galerie-titre" style="font-size:1.2rem;margin-bottom:1rem;">Galerie du menu ({{ menu.images|length }} photo{{ menu.images|length > 1 ? 's' }})</h2>
            {% if menu.images is empty %}
                <p style="color:#4b5563;margin:0;">Aucune photo pour l'instant. Ajoutez-en avec le champ « Ajouter des photos à la galerie » ci-dessus.</p>
            {% else %}
                <ul style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:1rem;">
                    {% for image in menu.images %}
                        <li style="border:1px solid #e5e7eb;border-radius:0.75rem;overflow:hidden;">
                            <img src="{{ asset(image.path) }}" alt="{{ image.alt }}" style="width:100%;height:110px;object-fit:cover;display:block;">
                            <form method="post" action="{{ path('admin_menu_image_delete', {id: menu.id, imageId: image.id}) }}" style="padding:0.5rem;" onsubmit="return confirm('Retirer cette photo de la galerie ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_image' ~ image.id) }}">
                                <button type="submit" style="width:100%;background:#FEE2E2;color:#991B1B;border:none;border-radius:0.5rem;padding:0.4rem;cursor:pointer;font-weight:600;">
                                    Retirer<span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;"> la photo {{ loop.index }}</span>
                                </button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    {% endif %}
</div>
{% endblock %}
